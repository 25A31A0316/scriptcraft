# ScriptCraft Web Frontend Environment Variables
# For local development with FastAPI running on port 8000:
VITE_API_URL=http://127.0.0.1:8000
VITE_WS_URL=ws://127.0.0.1:8000

# For production deployment (e.g. Render, Railway, Fly.io):
# VITE_API_URL=https://scriptcraft-api.yourdomain.com
# VITE_WS_URL=wss://scriptcraft-api.yourdomain.com
